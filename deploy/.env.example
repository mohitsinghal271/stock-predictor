# Autonomous NSE Quant Research Engine Configuration
PORT=8000
PYTHONUNBUFFERED=1

# Remote MCP Endpoints
MCP_BHAVCOPY_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
MCP_MARKET_URL=https://mcp.nseindia.in/cmmkt/mcp

# Database (Defaults to local SQLite / Parquet)
DATABASE_URL=sqlite:///data_store/research_store.db
# DATABASE_URL=postgresql://user:password@hostname:5432/quant_db

# ============================================================
# ALERT NOTIFICATION CHANNELS (Configure any or all)
# ============================================================

# 1. Telegram Bot (Free)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=987654321

# 2. Email Alerts (e.g. Gmail SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_gmail_app_password
# ALERT_EMAIL_TO=recipient_email@gmail.com

# 3. WhatsApp Alerts:
# Option A: CallMeBot (Free personal WhatsApp in 60 seconds - no signup)
# CALLMEBOT_PHONE=+919876543210
# CALLMEBOT_API_KEY=1234567

# Option B: Twilio WhatsApp (Business API)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_TO=whatsapp:+919876543210

# 4. Webhook Alerts (Slack, Discord, Custom)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
